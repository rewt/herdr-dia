{
  "manifest_version": 3,
  "name": "Herdr for Dia",
  "version": "0.1.0",
  "description": "Review and update the pull requests in your brief with Herdr agents.",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Herdr"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
